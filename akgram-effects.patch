+        echoBuf = new short[delay];
+        echoPos = 0;
+      }
+      for (int i = 0; i < n; i++) {
+        int dry = buf.getShort(i * 2);
+        int wet = echoBuf[echoPos];
+        int out = dry + wet / 2;
+        if (out > 32767) {
+          out = 32767;
+        } else if (out < -32768) {
+          out = -32768;
+        }
+        buf.putShort(i * 2, (short) out);
+        int fb = dry + wet * 2 / 5;
+        if (fb > 32767) {
+          fb = 32767;
+        } else if (fb < -32768) {
+          fb = -32768;
+        }
+        echoBuf[echoPos] = (short) fb;
+        echoPos++;
+        if (echoPos >= delay) {
+          echoPos = 0;
+        }
+      }
+    }
+  }
